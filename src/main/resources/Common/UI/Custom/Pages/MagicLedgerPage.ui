$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 600, Height: 480);

  #Title {
    Group {
      $C.@Title {
        @Text = %server.magicledger.ui.ledgerTitle;
      }
    }
  }

  #Content {
    Group #Header {
      LayoutMode: Left;
      Padding: (Left: 6, Right: 6, Bottom: 5);

      Button #SortName {
        FlexWeight: 1;
        LayoutMode: Left;
        Style: (Hovered: (Background: #000000(0.2)));

        Label #Label {
          FlexWeight: 1;
          Padding: (Right: 10, Vertical: 3);
          Text: %server.magicledger.ui.item;
          Style: (RenderBold: true);
        }
      }

      Button #SortCount {
        Anchor: (Width: 120);
        LayoutMode: Left;
        Style: (Hovered: (Background: #000000(0.2)));

        Label #Label {
          FlexWeight: 1;
          Padding: (Horizontal: 10, Vertical: 3);
          Text: %server.magicledger.ui.count;
          Style: (RenderBold: true, HorizontalAlignment: End);
        }
      }

      Button #SortCarried {
        Anchor: (Width: 120);
        LayoutMode: Left;
        Visible: false;
        Style: (Hovered: (Background: #000000(0.2)));

        Label #Label {
          FlexWeight: 1;
          Padding: (Horizontal: 10, Vertical: 3);
          Text: %server.magicledger.ui.carried;
          Style: (RenderBold: true, HorizontalAlignment: End, TextColor: #f2c45a);
        }
      }
    }

    Group #ElementList {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }

    Group #Empty {
      FlexWeight: 1;
      LayoutMode: Middle;
      Visible: false;

      Label {
        Text: %server.magicledger.ui.noItems;
        Style: (Alignment: Center);
      }
    }
  }
}

$C.@BackButton {}
