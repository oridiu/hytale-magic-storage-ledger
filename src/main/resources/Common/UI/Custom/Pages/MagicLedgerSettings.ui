$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 560);

    #Title {
      $C.@Title {
        @Text = %server.magicledger.ui.settingsTitle;
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 16);

        Group {
          LayoutMode: Top;
          FlexWeight: 1;

          Label {
            Text: %server.magicledger.ui.horizontalRadius;
            Anchor: (Bottom: 4);
            Style: $C.@DefaultLabelStyle;
          }

          $C.@NumberField #HorizontalRadius {
            @Anchor = (Width: 100, Left: 0);

            Format: (MaxDecimalPlaces: 0, Step: 1, MinValue: 0, MaxValue: 64);
          }
        }

        Group {
          LayoutMode: Top;
          FlexWeight: 1;

          Label {
            Text: %server.magicledger.ui.verticalRadius;
            Anchor: (Bottom: 4);
            Style: $C.@DefaultLabelStyle;
          }

          $C.@NumberField #VerticalRadius {
            @Anchor = (Width: 100, Left: 0);

            Format: (MaxDecimalPlaces: 0, Step: 1, MinValue: 0, MaxValue: 64);
          }
        }
      }

      Label {
        Text: %server.magicledger.ui.radiusHint;
        Anchor: (Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13);
      }

      Group {
        Anchor: (Vertical: 12, Height: 1);
        Background: #5e512c;
      }

      $C.@TextButton #SaveButton {
        Text: %server.customUI.saveChanges;
      }
    }
  }
}

$C.@BackButton {}
